@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using CloudMVCApplication.Data
@using CloudMVCApplication.Models
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@{
    Layout = null;
    var title = ViewData["Title"]?.ToString() ?? "Manager";
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.FullName ?? "Manager";
    var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpperInvariant();
    var unreadNotifications = currentUser == null
        ? 0
        : await DbContext.Notifications.CountAsync(n => n.UserId == currentUser.Id && !n.IsRead);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - ZamMaintain</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/manager.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toast.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/confirm.css" asp-append-version="true" />
</head>
<body class="pm-body">
    <partial name="~/Views/Shared/_ToastNotifications.cshtml" />
    <partial name="~/Views/Shared/_ConfirmDialog.cshtml" />
    <div class="manager-shell">
        @await Html.PartialAsync("~/Areas/Manager/Views/Shared/_ManagerSidebar.cshtml")

        <div class="manager-main">
            <header class="manager-topbar pm-topbar">
                <div class="pm-topbar__left">
                    <span class="pm-topbar__section">@title</span>
                </div>
                <div class="pm-topbar__right">
                    <a class="pm-topbar__icon pm-topbar__icon--notify" asp-area="Manager" asp-controller="Manager" asp-action="Notifications" title="Notifications">
                        <span class="material-symbols-outlined">notifications</span>
                        @if (unreadNotifications > 0)
                        {
                            <span class="pm-topbar__badge">@unreadNotifications</span>
                        }
                    </a>
                    <a class="pm-topbar__icon" asp-area="Manager" asp-controller="Manager" asp-action="Profile" title="Account settings"><span class="material-symbols-outlined">settings</span></a>
                    <a class="pm-topbar__avatar" asp-area="Manager" asp-controller="Manager" asp-action="Profile" title="Profile">
                        @if (!string.IsNullOrWhiteSpace(currentUser?.AvatarUrl))
                        {
                            <img src="@currentUser.AvatarUrl" alt="Profile" />
                        }
                        else
                        {
                            @initials
                        }
                    </a>
                </div>
            </header>

            <main class="manager-content pm-main" role="main">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/confirm-dialog.js" asp-append-version="true"></script>
    <script src="~/js/form-state.js" asp-append-version="true"></script>
    <script src="~/js/photo-preview.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
