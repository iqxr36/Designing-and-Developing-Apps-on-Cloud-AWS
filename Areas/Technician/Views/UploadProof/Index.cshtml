@model CloudMVCApplication.ViewModels.TechnicianProofUploadViewModel
@{
    ViewData["Title"] = "Upload Completion Proof";
}

<div class="pm-page-header">
    <h1 class="pm-page-title">Upload completion proof</h1>
    <p class="pm-page-lead">Submit photo evidence and notes after completing an assigned job.</p>
</div>

@if (!Model.ActiveJobs.Any())
{
    <div class="pm-card">
        <div class="pm-card__body text-center py-5">
            <span class="material-symbols-outlined" style="font-size:3rem;color:var(--pm-primary)">task_alt</span>
            <h2 class="h5 mt-4">No active jobs need proof</h2>
            <p class="pm-muted">Completed jobs will appear in Job History after proof is submitted.</p>
            <a class="pm-btn pm-btn--primary mt-4" asp-area="Technician" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a>
        </div>
    </div>
}
else
{
    <form asp-area="Technician" asp-controller="UploadProof" asp-action="Upload" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="pm-card">
                    <div class="pm-card__body">
                        <label class="pm-label pm-label--required" for="requestId">Select job</label>
                        <select class="pm-select" id="requestId" name="requestId" onchange="window.location.href='@Url.Action("Index", "UploadProof", new { area = "Technician" })?requestId=' + this.value">
                            @foreach (var job in Model.ActiveJobs)
                            {
                                <option value="@job.RequestId" selected="@(job.RequestId == Model.RequestId)">@job.DisplayId - @job.Title</option>
                            }
                        </select>

                        @if (Model.SelectedJob != null)
                        {
                            <hr class="my-4" style="border-color:var(--pm-border)" />
                            <div class="pm-label">Selected job</div>
                            <h2 class="h5 mt-1">@Model.SelectedJob.Title</h2>
                            <p class="pm-muted">#@Model.SelectedJob.DisplayId • @Model.SelectedJob.Category</p>

                            <div class="mt-3 p-3 border rounded">
                                <div class="pm-label">Location</div>
                                <p class="mb-0"><strong>@Model.SelectedJob.PropertyName, Unit @Model.SelectedJob.UnitNumber</strong></p>
                            </div>

                            <div class="mt-3 p-3 border rounded">
                                <div class="pm-label">Priority</div>
                                <p class="mb-0"><strong>@Model.SelectedJob.Priority</strong></p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-8 d-flex flex-column gap-4">
                <div class="pm-card">
                    <div class="pm-card__body text-center py-4">
                        <span class="material-symbols-outlined" style="font-size:3rem;color:var(--pm-primary)">add_a_photo</span>
                        <h2 class="h5 mt-3">Add completion photos</h2>
                        <p class="pm-muted mx-auto" style="max-width:28rem">Upload clear photos showing the completed repair. JPG, PNG, GIF, and WebP files are supported.</p>
                        <input class="pm-input mt-4 mx-auto" style="max-width:28rem" id="files" name="files" type="file" accept="image/*" multiple />
                        <p class="pm-field-hint mx-auto" style="max-width:28rem">Multiple photos help managers verify the work before payment release. JPG, PNG, GIF, or WebP up to 10MB each. Camera capture is supported.</p>
                        <p id="photo-validation-error" class="pm-field-error mx-auto" style="max-width:28rem" hidden></p>
                        @Html.ValidationMessage("files", new { @class = "pm-field-error" })
                    </div>
                </div>

                <div class="pm-card">
                    <div class="pm-card__body">
                        <label class="pm-label" for="notes">Completion notes</label>
                        <textarea class="pm-textarea" id="notes" name="notes" rows="5" placeholder="Describe the work performed, materials used, and anything the manager should know.">@Model.Notes</textarea>
                        <p class="pm-field-hint">Mention parts replaced, tests performed, and any follow-up needed.</p>
                    </div>
                </div>

                <div class="pm-actions justify-content-end">
                    <a class="pm-btn pm-btn--outline" asp-area="Technician" asp-controller="Dashboard" asp-action="Index">Cancel</a>
                    <button type="submit" class="pm-btn pm-btn--primary">
                        Submit proof
                        <span class="material-symbols-outlined" style="font-size:20px">send</span>
                    </button>
                </div>
            </div>
        </div>
    </form>
}

@section Scripts {
    <script>
        (function () {
            var form = document.querySelector('form[enctype="multipart/form-data"]');
            var input = document.getElementById('files');
            var errorEl = document.getElementById('photo-validation-error');
            if (!form || !input) return;

            var maxSize = 10 * 1024 * 1024;
            var allowedExt = ['.jpg', '.jpeg', '.png', '.gif', '.webp'];
            var allowedMime = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];

            function ext(name) {
                var i = name.lastIndexOf('.');
                return i < 0 ? '' : name.substring(i).toLowerCase();
            }

            function validate(files) {
                if (!files || !files.length) return 'Upload at least one completion photo.';
                for (var i = 0; i < files.length; i++) {
                    var f = files[i];
                    if (!f.size) return 'Photos cannot be empty.';
                    if (f.size > maxSize) return 'Each proof image must be 10MB or smaller.';
                    var e = ext(f.name || '');
                    if (!e || allowedExt.indexOf(e) === -1) return 'Only JPG, PNG, GIF, or WebP files are allowed.';
                    if (f.type && allowedMime.indexOf(String(f.type).toLowerCase()) === -1) return 'Only JPG, PNG, GIF, or WebP files are allowed.';
                }
                return null;
            }

            function showError(msg) {
                if (!errorEl) { window.alert(msg); return; }
                errorEl.textContent = msg || '';
                errorEl.hidden = !msg;
            }

            input.addEventListener('change', function () {
                var err = validate(input.files);
                if (err) {
                    showError(err);
                    input.value = '';
                } else {
                    showError('');
                }
            });

            form.addEventListener('submit', function (event) {
                var err = validate(input.files);
                if (err) {
                    event.preventDefault();
                    showError(err);
                }
            });
        })();
    </script>
}
