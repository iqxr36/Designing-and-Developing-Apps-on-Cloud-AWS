@model CloudMVCApplication.ViewModels.ChatViewModel
@{
    ViewData["Title"] = "Chat";
    ViewData["SendUrl"] = Url.Action("Send", "Messages", new { area = "Technician", id = Model.ConversationId })!;
}

<div class="mb-3">
    <a class="pm-link-back" asp-area="Technician" asp-controller="Messages" asp-action="Index">
        <span class="material-symbols-outlined" style="font-size:18px">arrow_back</span> Back to Messages
    </a>
</div>

@await Html.PartialAsync("~/Views/Shared/Messaging/_ChatRoom.cshtml", Model)
