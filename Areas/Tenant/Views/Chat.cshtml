@model CloudMVCApplication.ViewModels.ChatViewModel
@{
    Layout = "~/Areas/Tenant/Views/Shared/_TenantLayout.cshtml";
    ViewData["Title"] = "Chat";
    ViewData["SendUrl"] = Url.Action("Send", "Messages", new { area = "Tenant", id = Model.ConversationId })!;
}

<div class="mb-3">
    <a class="pm-link-back" asp-area="Tenant" asp-controller="Messages" asp-action="Index"><span class="material-symbols-outlined" style="font-size:18px">arrow_back</span> Back to Messages</a>
</div>

<link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
@await Html.PartialAsync("~/Views/Shared/Messaging/_ChatRoom.cshtml", Model)
