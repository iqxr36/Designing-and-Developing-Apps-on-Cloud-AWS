@model CloudMVCApplication.ViewModels.MessagingInboxViewModel
@{
    Layout = "~/Areas/Tenant/Views/Shared/_TenantLayout.cshtml";
    ViewData["Title"] = "Messages";
    ViewData["ChatArea"] = "Tenant";
    ViewData["ChatController"] = "Messages";
    ViewData["ChatAction"] = "Chat";
}

<div class="pm-page-header mb-4">
    <h1 class="pm-page-title">Messages</h1>
    <p class="pm-page-lead">Chat with your property manager about maintenance requests.</p>
</div>

<link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
@await Html.PartialAsync("~/Views/Shared/Messaging/_ChatInbox.cshtml", Model)
@await Html.PartialAsync("~/Views/Shared/Messaging/_ChatInboxScripts.cshtml", Model)
