@page
@model CloudMVCApplication.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<main class="auth-recovery-main">
    <div class="auth-recovery-wrap">
        <div class="auth-brand-center">
            <span class="auth-brand-center-title">ZamMaintain</span>
            <span class="auth-brand-center-kicker">Enterprise Security</span>
        </div>

        <section class="auth-focused-card" aria-label="Reset password form">
            <h1 class="auth-card-title">Reset Password</h1>
            <p class="auth-card-subtitle">Choose a new password for your ZamMaintain account.</p>

            @if (!string.IsNullOrWhiteSpace(Model.InvalidLinkMessage))
            {
                <div class="auth-validation-summary" role="alert">@Model.InvalidLinkMessage</div>
                <div class="auth-card-link-row">
                    <a class="auth-link" href="/Identity/Account/ForgotPassword">
                        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                        Request a new reset link
                    </a>
                </div>
            }
            else
            {
                <form class="auth-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="auth-validation-summary" role="alert"></div>
                    <input type="hidden" asp-for="Input.Code" />

                    <div class="auth-field">
                        <label class="auth-label" asp-for="Input.Email">Email Address</label>
                        <div class="auth-input-wrapper">
                            <span class="material-symbols-outlined auth-input-icon" aria-hidden="true">mail</span>
                            <input class="auth-input"
                                   asp-for="Input.Email"
                                   autocomplete="username"
                                   readonly />
                        </div>
                        <span class="auth-validation-message" asp-validation-for="Input.Email"></span>
                    </div>

                    <div class="auth-field">
                        <label class="auth-label" asp-for="Input.Password">New Password</label>
                        <div class="auth-input-wrapper auth-input-wrapper--password">
                            <input class="auth-input"
                                   id="ResetPassword"
                                   asp-for="Input.Password"
                                   autocomplete="new-password"
                                   placeholder="New password" />
                            <button class="auth-password-toggle" type="button" data-password-toggle="ResetPassword">
                                <span class="material-symbols-outlined" aria-hidden="true" data-password-toggle-icon>visibility</span>
                            </button>
                        </div>
                        <span class="auth-validation-message" asp-validation-for="Input.Password"></span>
                    </div>

                    <div class="auth-field">
                        <label class="auth-label" asp-for="Input.ConfirmPassword">Confirm Password</label>
                        <div class="auth-input-wrapper auth-input-wrapper--password">
                            <input class="auth-input"
                                   id="ResetConfirmPassword"
                                   asp-for="Input.ConfirmPassword"
                                   autocomplete="new-password"
                                   placeholder="Confirm password" />
                            <button class="auth-password-toggle" type="button" data-password-toggle="ResetConfirmPassword">
                                <span class="material-symbols-outlined" aria-hidden="true" data-password-toggle-icon>visibility</span>
                            </button>
                        </div>
                        <span class="auth-validation-message" asp-validation-for="Input.ConfirmPassword"></span>
                    </div>

                    <button class="auth-primary-button" type="submit">Reset Password</button>
                </form>

                <div class="auth-card-link-row">
                    <a class="auth-link" href="/Identity/Account/Login">
                        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                        Back to Log In
                    </a>
                </div>
            }
        </section>
    </div>
</main>

<footer class="auth-footer">
    <div class="auth-footer-inner">
        <div class="auth-footer-brand">
            <span class="auth-footer-logo">ZamMaintain</span>
            <span>&copy; 2026 ZamMaintain Enterprise. All rights reserved.</span>
        </div>
        <nav class="auth-footer-nav" aria-label="Footer links">
            <a class="auth-footer-link" href="/Home/Privacy">Privacy Policy</a>
            <a class="auth-footer-link" href="/Home/Terms">Terms of Service</a>
        </nav>
    </div>
</footer>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
