@page
@model CloudMVCApplication.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Password Recovery";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<main class="auth-recovery-main">
    <div class="auth-recovery-wrap">
        <div class="auth-brand-center">
            <span class="auth-brand-center-title">ZamMaintain</span>
            <span class="auth-brand-center-kicker">Enterprise Security</span>
        </div>

        @if (Model.RecoverySubmitted)
        {
            <section class="auth-focused-card" aria-live="polite">
                <span class="material-symbols-outlined auth-success-icon" aria-hidden="true">mark_email_read</span>
                <h1 class="auth-card-title">Check your email</h1>
                <p class="auth-card-subtitle">
                    If an account with this email exists, a password reset link has been sent.
                </p>
                <div class="auth-card-link-row">
                    <a class="auth-link" href="/Identity/Account/Login">
                        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                        Back to Log In
                    </a>
                </div>
            </section>
        }
        else
        {
            <section class="auth-focused-card" aria-label="Forgot password form">
                <h1 class="auth-card-title">Forgot Password</h1>
                <p class="auth-card-subtitle">
                    Enter your email address and we'll send you a link to reset your password.
                </p>

                <form class="auth-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="auth-validation-summary" role="alert"></div>

                    <div class="auth-field">
                        <label class="auth-label" asp-for="Input.Email">Email Address</label>
                        <div class="auth-input-wrapper">
                            <span class="material-symbols-outlined auth-input-icon" aria-hidden="true">mail</span>
                            <input class="auth-input"
                                   asp-for="Input.Email"
                                   autocomplete="email"
                                   placeholder="name@company.com" />
                        </div>
                        <span class="auth-validation-message" asp-validation-for="Input.Email"></span>
                    </div>

                    <button class="auth-primary-button" type="submit">
                        Send Reset Link
                    </button>
                </form>

                <div class="auth-card-link-row">
                    <a class="auth-link" href="/Identity/Account/Login">
                        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                        Back to Log In
                    </a>
                </div>
            </section>
        }
    </div>
</main>

<footer class="auth-footer">
    <div class="auth-footer-inner">
        <div class="auth-footer-brand">
            <span class="auth-footer-logo">ZamMaintain</span>
            <span>&copy; 2026 ZamMaintain Enterprise. All rights reserved.</span>
        </div>
        <nav class="auth-footer-nav" aria-label="Footer links">
            <a class="auth-footer-link" href="#">Privacy Policy</a>
            <a class="auth-footer-link" href="#">Terms of Service</a>
            <a class="auth-footer-link" href="#">Security</a>
            <a class="auth-footer-link" href="#">Contact Support</a>
        </nav>
    </div>
</footer>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
