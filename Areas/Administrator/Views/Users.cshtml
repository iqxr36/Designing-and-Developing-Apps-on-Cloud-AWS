@model CloudMVCApplication.ViewModels.AreaDashboardViewModel
@{
    Layout = "~/Areas/Administrator/Views/Shared/_AdministratorLayout.cshtml";
    ViewData["Title"] = "User Management";
}

<div class="pm-flex-between pm-page-header">
    <div>
        <h1 class="pm-page-title">User Management</h1>
        <p class="pm-page-lead">Manage staff accounts, assign roles, and monitor system access.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="pm-btn pm-btn--primary" asp-controller="Administrator" asp-action="AddUser">
            <span class="material-symbols-outlined">add</span> Add New User
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="pm-card mb-3" style="border-left: 4px solid #0a5c2e;">
        <div class="pm-card__body" style="color: #0a5c2e; font-weight: 600;">@successMessage</div>
    </div>
}

<form class="row g-3 align-items-end mb-3" asp-controller="Administrator" asp-action="Users" method="get">
    <div class="col-md-4 col-lg-3" style="flex: 2;">
        <label>Search Users</label>
        <div style="position: relative;">
            <span class="material-symbols-outlined" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--pm-on-surface-variant);">search</span>
            <input type="text" name="search" class="pm-input" value="@ViewBag.Search" placeholder="Search by name, email, or phone..." style="padding-left: 40px;" />
        </div>
    </div>
    <div class="col-md-4 col-lg-3">
        <label>Role</label>
        <select name="role" class="pm-select">
            <option value="">All Roles</option>
            <option value="Administrator" selected="@(ViewBag.Role == "Administrator")">Admin</option>
            <option value="Manager" selected="@(ViewBag.Role == "Manager")">Property Manager</option>
            <option value="Tenant" selected="@(ViewBag.Role == "Tenant")">Tenant</option>
        </select>
    </div>
    <div class="col-md-4 col-lg-3">
        <label>Status</label>
        <select name="status" class="pm-select">
            <option value="">All Statuses</option>
            <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
            <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
        </select>
    </div>
    <button class="pm-btn pm-btn--secondary" type="submit" style="align-self: flex-end;">
        <span class="material-symbols-outlined">filter_list</span> Apply
    </button>
</form>

<div class="pm-card">
    @{
        var page = (int)(ViewBag.Page ?? 1);
        var totalPages = (int)(ViewBag.TotalPages ?? 1);
        var totalItems = (int)(ViewBag.TotalItems ?? Model.Users.Count);
    }
    @if (!Model.Users.Any())
    {
        <div class="pm-empty-state">
            <div class="pm-empty-state__icon"><span class="material-symbols-outlined">group_off</span></div>
            <h2 class="pm-empty-state__title">No users found</h2>
            <p class="pm-empty-state__text">No user accounts match the current search or filters.</p>
            <div class="pm-empty-state__actions">
                <a class="pm-btn pm-btn--secondary" asp-controller="Administrator" asp-action="Users">Clear filters</a>
                <a class="pm-btn pm-btn--primary" asp-controller="Administrator" asp-action="AddUser">Add user</a>
            </div>
        </div>
    }
    else
    {
        <div class="pm-table-wrap">
            <table class="pm-table">
                <thead>
                    <tr>
                        <th>User Details</th>
                        <th>Role</th>
                        <th>Contact Info</th>
                        <th>Status</th>
                        <th class="pm-text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        var rowStyle = user.Status == "Active" ? string.Empty : "opacity: 0.6;";
                        var badgeClass = user.Status == "Active" ? "pm-badge--completed" : "pm-badge--pending";
                        <tr style="@rowStyle">
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div style="width: 40px; height: 40px; border-radius: 999px; background: #800000; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700;">@user.Initials</div>
                                    <div>
                                        <p style="font-weight: 600; margin: 0;">@user.FullName</p>
                                        <p class="pm-muted small" style="margin: 0;">@user.Email</p>
                                    </div>
                                </div>
                            </td>
                            <td>@user.Role</td>
                            <td>@(user.PhoneNumber ?? "No phone on file")</td>
                            <td><span class="pm-badge @badgeClass">@user.Status</span></td>
                            <td class="pm-text-end">
                                <a class="pm-btn pm-btn--link" asp-controller="Administrator" asp-action="UserDetail" asp-route-id="@user.Id">
                                    <span class="material-symbols-outlined">more_vert</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav class="pm-card__pager" aria-label="User pages">
            <span class="pm-card__pager-summary">Showing @Model.Users.Count of @totalItems users</span>
            <div class="pm-card__pager-pages">
            @if (page > 1)
            {
                <a class="page-link" asp-controller="Administrator" asp-action="Users" asp-route-pageNumber="@(page - 1)" asp-route-search="@ViewBag.Search" asp-route-role="@ViewBag.Role" asp-route-status="@ViewBag.Status" aria-label="Previous page"><span class="material-symbols-outlined">chevron_left</span></a>
            }
            @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
            {
                <a class="page-link @(pageNumber == page ? "active" : null)" asp-controller="Administrator" asp-action="Users" asp-route-pageNumber="@pageNumber" asp-route-search="@ViewBag.Search" asp-route-role="@ViewBag.Role" asp-route-status="@ViewBag.Status" aria-current="@(pageNumber == page ? "page" : null)">@pageNumber</a>
            }
            @if (page < totalPages)
            {
                <a class="page-link" asp-controller="Administrator" asp-action="Users" asp-route-pageNumber="@(page + 1)" asp-route-search="@ViewBag.Search" asp-route-role="@ViewBag.Role" asp-route-status="@ViewBag.Status" aria-label="Next page"><span class="material-symbols-outlined">chevron_right</span></a>
            }
            </div>
        </nav>
    }
</div>
