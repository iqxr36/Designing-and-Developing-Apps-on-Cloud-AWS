@model CloudMVCApplication.ViewModels.AreaDashboardViewModel
@{
    Layout = "~/Areas/Administrator/Views/Shared/_AdministratorLayout.cshtml";
    ViewData["Title"] = "Request Submitted";
    var request = Model.SelectedRequest;
}

<div style="max-width: 600px; margin: 80px auto; text-align: center;">
    <div style="width: 80px; height: 80px; border-radius: 999px; background: #d6f0e0; color: #0a5c2e; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
        <span class="material-symbols-outlined" style="font-size: 40px;">check_circle</span>
    </div>
    <h1 class="pm-page-title mb-2">Request Submitted Successfully</h1>
    <p class="pm-page-lead" style="margin-bottom: 32px;">Your maintenance request has been created and is now being processed.</p>
    
    <div class="pm-card" style="text-align: left; margin-bottom: 24px;">
        <div class="pm-card__body">
            <div class="row g-3">
                <div>
                    <p class="pm-muted small" style="margin: 0;">Request ID</p>
                    <p style="font-weight: 600; margin: 4px 0 0; color: var(--pm-primary);">@request?.DisplayId</p>
                </div>
                <div>
                    <p class="pm-muted small" style="margin: 0;">Status</p>
                    <p style="margin: 4px 0 0;"><span class="pm-badge pm-badge--pending">@request?.Status</span></p>
                </div>
                <div>
                    <p class="pm-muted small" style="margin: 0;">Priority</p>
                    <p style="font-weight: 600; margin: 4px 0 0;">@request?.Priority</p>
                </div>
                <div>
                    <p class="pm-muted small" style="margin: 0;">Assigned To</p>
                    <p style="font-weight: 600; margin: 4px 0 0;">@(request?.TechnicianName ?? "Unassigned")</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="d-flex gap-3" style="justify-content: center;">
        <a class="pm-btn pm-btn--secondary" asp-controller="Administrator" asp-action="CreateRequest">Create Another</a>
        <a class="pm-btn pm-btn--primary" asp-controller="Administrator" asp-action="Maintenance">View All Requests</a>
    </div>
</div>
