<div class="app-confirm" data-confirm-dialog hidden>
    <div class="app-confirm__backdrop" data-confirm-cancel></div>
    <section class="app-confirm__panel" role="dialog" aria-modal="true" aria-labelledby="appConfirmTitle" aria-describedby="appConfirmMessage" tabindex="-1">
        <div class="app-confirm__icon" aria-hidden="true">
            <span class="material-symbols-outlined">priority_high</span>
        </div>
        <div class="app-confirm__content">
            <h2 class="app-confirm__title" id="appConfirmTitle">Confirm action</h2>
            <p class="app-confirm__message" id="appConfirmMessage">Are you sure you want to continue?</p>
        </div>
        <div class="app-confirm__actions">
            <button class="pm-btn pm-btn--secondary app-confirm__cancel" type="button" data-confirm-cancel>Cancel</button>
            <button class="pm-btn pm-btn--primary app-confirm__submit" type="button" data-confirm-submit>Confirm</button>
        </div>
    </section>
</div>
